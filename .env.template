# Copy to .env and fill in real values.
# .env is gitignored and must never be committed.

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_USER=rental_automation
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=rental_automation
DATABASE_URL=postgresql+asyncpg://rental_automation:change_me_in_production@db:5432/rental_automation

# ── Google OAuth (one Cloud project; separate refresh tokens per account) ──────
# Create at console.cloud.google.com → APIs & Services → Credentials
# Enable: Gmail API, Google Sheets API
# OAuth consent screen: External, scopes: gmail.readonly, gmail.send, spreadsheets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Refresh token for the booking-feed inbox (reads incoming booking/reply emails)
GMAIL_BOOKING_FEED_REFRESH_TOKEN=
# Refresh token for the alerts inbox (sends actionable alert emails to owners)
GMAIL_ALERTS_REFRESH_TOKEN=
# Refresh token for the Google account that has access to the cleaner schedule sheet
GOOGLE_SHEETS_REFRESH_TOKEN=
# "Sign in with Google" for the dashboard — a SEPARATE *Web application* OAuth
# client (redirect URIs: https://<domain>/auth/callback and
# http://localhost:8000/auth/callback). Allowed sign-in emails go in config.yaml
# (dashboard.allowed_emails).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── DocuSign eSign API ─────────────────────────────────────────────────────────
# developers.docusign.com → Apps and Keys
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_CLIENT_ID=
DOCUSIGN_CLIENT_SECRET=
DOCUSIGN_REFRESH_TOKEN=
# true = sandbox/demo hosts (default, safe); false = production hosts (go-live only, Step 20)
DOCUSIGN_SANDBOX=true
# Production only: this account's regional REST base URI from OAuth userinfo
# (e.g. https://na4.docusign.net/restapi). DocuSign is multi-region — calls must
# hit the account's own instance. Leave blank for sandbox; blank in prod falls
# back to https://www.docusign.net/restapi (only correct for www-instance accounts).
DOCUSIGN_API_BASE_URI=
# HMAC secret for Connect webhook signature validation (DocuSign Admin → Connect)
DOCUSIGN_HMAC_KEY=

# ── Seam API ───────────────────────────────────────────────────────────────────
# dashboard.getseam.com → API Keys
SEAM_API_KEY=

# ── App ────────────────────────────────────────────────────────────────────────
# Signs the dashboard session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_random_key_here
# VPS domain for Caddy TLS (leave as localhost for local dev)
DOMAIN=localhost

# Deploy target used by .claude/skills/deploying-to-vps (dev machine only).
# SSH destination (user@host — a Tailscale MagicDNS name works) and the
# absolute path of this repo's clone on the VPS.
DEPLOY_VPS_SSH=
DEPLOY_VPS_REPO_DIR=

# ── External monitoring (sustainability audit 2026-07-23) ──────────────────────
# Unique healthchecks.io ping URLs (https://hc-ping.com/<uuid>). Each job pings
# its URL only on SUCCESS; the external monitor alerts the owner when pings
# stop, through its own email/push — independent of this app's Gmail tokens.
# Leave empty to disable (pings are silently skipped).
HEALTHCHECKS_PING_URL_POLLER=
HEALTHCHECKS_PING_URL_SENTINEL=
HEALTHCHECKS_PING_URL_KEEPALIVE=
# Used only by the VPS backup crontab line (not read by the app):
HEALTHCHECKS_PING_URL_BACKUP=

# ── Off-site backups to Cloudflare R2 (scripts/offsite_backup.sh, VPS only) ───
# R2 → Manage R2 API Tokens → token scoped to ONE bucket (Object Read & Write).
# The account id is the hex prefix of your R2 endpoint URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Symmetric passphrase for client-side encryption (gpg) of every uploaded file.
# Generate long + random; store a copy in your password manager — without it
# the off-site backups are unreadable.
BACKUP_ENCRYPTION_PASSPHRASE=
# How many encrypted versions of each file type to keep in the bucket.
OFFSITE_RETENTION_COUNT=25

# ── Manual E2E scripts (scripts/manual/, never read by the app) ────────────────
# scripts/manual/e2e_full_flow.py and golive_e2e.py send REAL email against the
# live/sandbox integrations. They have no built-in recipients: an unset variable
# aborts the run rather than falling back to anyone's personal inbox.
# Inbox that receives the real DocuSign signing request. Must be an inbox you
# own, and must NOT be the DocuSign account owner address — demo DocuSign
# suppresses the signing email when signer == account owner.
E2E_GUEST_EMAIL=
# Test inbox the live HOA send is redirected to. golive_e2e.py additionally
# refuses to run unless config.yaml's HOA email equals this value, so a live
# run can never reach the real HOA.
E2E_HOA_RECIPIENT=
